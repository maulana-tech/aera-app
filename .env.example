# Web app environment. Copy to .env.local:  cp .env.example .env.local

# The AERA agent service (cd aera/agent && python3 api.py). Server-side only:
# the browser never sees this URL or the session token.
AERA_API=http://127.0.0.1:8787

# Optional: a "Use the demo account" button on /login fills these in. Use a viewer
# account (it approves nothing); anyone who opens /login can see them.
# AERA_DEMO_EMAIL=demo@aera.example
# AERA_DEMO_PASSWORD=
