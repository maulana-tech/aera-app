# SIGAP agent service. Copy this file, then fill it in:
#   cp .env.example .env
#
# ENV.md one directory up explains every line below: what it is for, where to
# get it, and how to check it is working. Read that first if a value is blank.
#
# A trailing "# comment" after a value is stripped. A trailing note WITHOUT a #
# is kept as part of the value, which is how a region ends up named
# "us-west-2  fill this in later".
#
# This file is tracked by git. The .env you make from it is not. Never put a
# real key, password or secret in here.

# ---------------------------------------------------------------- required
# Signs session tokens. Whoever holds it can mint an admin session, so
# generate your own and never share or commit it:
#   PYTHONPATH=. python3 manage.py secret
SIGAP_SECRET=

# ------------------------------------------------------------------- SAP
# Free, personal, from https://api.sap.com (an SAP ID account, which is not
# the hackathon IAS tenant). Empty means every read falls back to fixtures/
# and is labelled MODELLED, which the interface shows and the calculator
# refuses to price.
SAP_API_KEY=
SAP_BASE_URL=https://sandbox.api.sap.com
# SAP_TIMEOUT=30

# ---------------------------------------------------------------- models
# ENV.md, under Models, walks through the Bedrock setup. A model is named
# provider:model (bedrock | bedrock-openai | aicore); a bare anthropic.* id
# means bedrock. Check what you set with: python3 manage.py models --ping
#
# Bedrock region. ap-southeast-2 (Sydney) serves Claude 4.6 through global.
# profiles and DeepSeek, Kimi, Qwen, GLM, gpt-oss, Mistral and MiniMax on
# Mantle. Grant the models in the Bedrock console FIRST. AWS credentials
# themselves do not belong here: `aws configure`, an AWS_PROFILE, or
# AWS_BEARER_TOKEN_BEDROCK in .secrets/bedrock.env, and the standard chain
# finds them.
AWS_REGION=
# Required second AWS account used when the primary Bedrock account is rate-limited.
# Keep these in the deployment secret store, never in git:
AWS_FALLBACK_ACCESS_KEY_ID=
AWS_FALLBACK_SECRET_ACCESS_KEY=
AWS_FALLBACK_REGION=ap-southeast-2
# Required only when the fallback credentials are temporary STS credentials.
# AWS_FALLBACK_SESSION_TOKEN=
# The deciders, Arya (lead) and Kira (veto). Also everyone else, unless the
# next line is set. MiniMax M2.5 handled the Ningbo closure for Rp 1,435 with
# every agent on it (ENV.md, Models). For the strongest lead, about 3.5x the
# cost: global.anthropic.claude-opus-4-6-v1, with the specialists line below.
SIGAP_MODEL=bedrock-openai:minimax.minimax-m2.5
# The other ten specialists. Empty: they run on SIGAP_MODEL. Any of these can
# also be picked in the app, Settings -> Models, which wins over this file.
# SIGAP_MODEL_SPECIALISTS=bedrock-openai:minimax.minimax-m2.5
# SIGAP_MODEL_SPECIALISTS=bedrock-openai:deepseek.v3.2
# One agent on its own model: SIGAP_MODEL_<CODE>, e.g.
# SIGAP_MODEL_LOGISTICS=aicore:gpt-5.4
# Tried once when an agent's model fails, then kept for that handling. With no
# AWS set up at all, this is what the whole team runs on.
# SIGAP_MODEL_FALLBACK=aicore:gpt-5.4
# Maximum concurrent event reasonings. Keep at 1 for a small Bedrock quota.
# SIGAP_REASONING_WORKERS=1
# Narration and titles only, never a figure (core/aux.py).
SIGAP_AUX_MODEL=bedrock-openai:zai.glm-4.7-flash

# ---------------------------------------------------------- SAP AI Core
# The organisers' AI Core: gpt-5.4 (fallback brain) and SAP RPT-1.6 (Vega's
# slip ranking). The service key is a file, kept out of git, never pasted here.
# SIGAP_AICORE_KEY_FILE=.secrets/ai-core.json
# AICORE_RESOURCE_GROUP=default

# ------------------------------------------------------------- behaviour
# dev  : fixtures stand in for anything not connected
# prod : refuses events unless SAP and the model are both connected
SIGAP_ENV=dev

# The approval record. Use an absolute path on a server, and back this up.
SIGAP_DB=data/sigap.db

# The watchers (BMKG, hazards, weather, Vega). 0 stops the queue filling with
# live events, which is what you want in the hour before a demo. Alerts, the
# SAP sender and the morning digest keep running. ENV.md, Schedule.
# SIGAP_WATCH=1
# 0 stops everything that runs on its own, alert delivery included.
# SIGAP_SCHEDULE=1

# Where people open SIGAP. Every alert links there.
# SIGAP_WEB_URL=http://localhost:3000

# The rupiah rate model spend is priced at. manage.py ready checks it.
# SIGAP_IDR_PER_USD=16400

# Alerts: SMTP, Slack, Telegram or a webhook. The values are secrets, so they
# go in .secrets/notify.env (mode 600), not here. ENV.md, Alerts.
#   SIGAP_SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
#   SIGAP_SMTP_PORT=587
#   SIGAP_SMTP_USER=…
#   SIGAP_SMTP_PASSWORD=…
#   SIGAP_MAIL_FROM=sigap@your-company.co.id
#   SIGAP_SLACK_WEBHOOK_URL=…
#   SIGAP_TELEGRAM_BOT_TOKEN=…
#   SIGAP_TELEGRAM_CHAT_ID=…
#   SIGAP_WEBHOOK_URL=…
# Or email from a connected Gmail mailbox through Composio (then Connect Gmail
# on the Contacts page):
#   COMPOSIO_API_KEY=…
#   SIGAP_COMPOSIO_USER_ID=sigap
# A handling's alert carries its report: pdf | xlsx | pdf,xlsx | none
#   SIGAP_ALERT_ATTACH=pdf

# Messages to suppliers and customers, once a person approves them. Outside
# production they go to this one test address instead, or nowhere when unset.
#   SIGAP_EXTERNAL_REDIRECT=you@your-company.co.id
# In production, the only domains they may go to (comma-separated), if set.
#   SIGAP_EXTERNAL_DOMAINS=

# Ceiling for acting without a person. Value is only half the test: every
# figure under the decision must be trusted as well.
SIGAP_AUTONOMOUS_LIMIT_IDR=50000000
# Model spend per event before the handling stops.
SIGAP_COST_CAP_IDR=500000

# ------------------------------------------------------------------ bind
# Loopback by default. The platform sets PORT on Cloud Foundry, and setting it
# also flips the bind address to 0.0.0.0.
# PORT=8787
# SIGAP_HOST=127.0.0.1
