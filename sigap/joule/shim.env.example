# Settings for the A2A shim. Copy to shim.env for a local run (gitignored),
# or set each with `cf set-env sigap-a2a-shim NAME VALUE` on Cloud Foundry.
# Never commit real values.

# Where SIGAP is.
#   direct: the agent service itself, e.g. http://127.0.0.1:8797 (Bearer token)
#   bridge: the public web app, e.g. https://sigap.lumbungstack.dev (cookie)
SIGAP_API=http://127.0.0.1:8797
SIGAP_API_MODE=direct

# The planner service user the shim signs in as. Create it in sigap/agent:
#   PYTHONPATH=. python3 manage.py user <email> "Joule shim" planner <password>
SIGAP_SHIM_EMAIL=
SIGAP_SHIM_PASSWORD=

# Base of the links Joule shows (…/disruptions/<run_id>). Defaults to SIGAP_API
# in bridge mode. Empty in direct mode means answers show the run id only.
SIGAP_WEB_URL=

# The URL the agent card advertises. CF sets it from VCAP_APPLICATION; set it
# when running behind a tunnel.
SHIM_PUBLIC_URL=

# Each investigation spends model credit, and the shim's URL is public.
SHIM_MAX_EVENTS_PER_HOUR=10

# Optional: require X-Sigap-Shim-Token on every JSON-RPC call (README, Hardening).
SHIM_TOKEN=

PORT=8799
HOST=127.0.0.1
