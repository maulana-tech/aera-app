# Values for the Joule capability, read by render.py. Copy to joule.env
# (gitignored) and fill in. Never commit the real values.

# The BTP destination that points at the shim (HTTP, Internet, NoAuthentication).
# Unique per team on the shared subaccount, e.g. SIGAP_AGENT_<team>.
SIGAP_DESTINATION=

# The team's IAS group UUID (not its display name), from the organisers' BTP
# instructions, "Visibility Conditions". Gates every scenario to the team.
TEAM_IAS_GROUP_ID=
