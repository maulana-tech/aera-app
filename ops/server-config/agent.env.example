# AERA Agent Environment Configuration Template for EC2
# Location on EC2: /opt/sigap-project/aera/agent/.env

AERA_ENV=dev
AERA_SECRET=generate_random_64_char_hex_secret_here
AERA_DB=/app/data/sigap.db
AWS_REGION=ap-southeast-2
AERA_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
AERA_AUTONOMOUS_LIMIT_IDR=50000000
AERA_COST_CAP_IDR=500000
