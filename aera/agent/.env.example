# AERA agent service. cp .env.example .env, then fill it in.
# Secrets (keys) go in .secrets/*.env (gitignored, mode 600), not here.
# ../ENV.md explains every line.

# ---------------------------------------------------------------- required
# Signs session tokens:  PYTHONPATH=. python3 manage.py secret
AERA_SECRET=

# ---------------------------------------------------------------- models
# NEAR AI Cloud (cloud.near.ai, or claim $10 at nearbuilders.org/dashboard).
# Put the key in .secrets/near.env:  NEARAI_API_KEY=...
# AERA_PRIVATE=1 (default) allows ONLY models that run in an attested TEE.
AERA_PRIVATE=1
# The deciders (supervisor, guardian):
AERA_MODEL=nearai:moonshotai/kimi-k3
# Everyone else:
AERA_MODEL_SPECIALISTS=nearai:z-ai/glm-5.3-flash
# Tried once when an agent's model fails:
AERA_MODEL_FALLBACK=nearai:z-ai/glm-5.3
# Titles and drafts only (core/aux.py):
AERA_AUX_MODEL=nearai:z-ai/glm-5.3-flash
# One agent on its own model: AERA_MODEL_<CODE>, e.g. AERA_MODEL_WRITER=nearai:z-ai/glm-5.3

# ------------------------------------------------------------------ NEAR
# The vault (aera/contracts/aera-vault). `python3 manage.py near-setup` prints
# the commands. The agent key MUST be a function-call key; put these in
# .secrets/near.env:
#   NEAR_NETWORK=testnet
#   AERA_VAULT_CONTRACT=vault.<owner>.testnet
#   AERA_NEAR_AGENT_ACCOUNT=agent.<owner>.testnet
#   AERA_NEAR_AGENT_KEY=ed25519:...
#   AERA_USDC_TOKEN=            (defaults to Circle USDC on the network)
#   NEAR_RPC_URL=https://test.rpc.fastnear.com
# Without them payments run on the SIMULATED rail, labelled as such.
# NEAR Intents 1Click (mainnet only), optional:
#   ONECLICK_JWT=

# ------------------------------------------------------------- limits
# Most the team may pay on its own, per payment (the profile can only lower it).
AERA_PAY_AUTONOMOUS_LIMIT_USD=50
# Model spend per run before the handling stops.
AERA_COST_CAP_USD=1.0
# Concurrent handlings.
# AERA_REASONING_WORKERS=2

# ------------------------------------------------------------- behaviour
AERA_ENV=dev
AERA_DB=data/aera.db
# 0 stops the team starting work on its own (work items, goals). Settlement,
# alerts and the digest keep running.
# AERA_WATCH=1
# AERA_SCHEDULE=1
# AERA_WEB_URL=http://localhost:3000

# Outward messages (to customers and vendors): outside production they go to
# this one address, or nowhere when unset.
# AERA_EXTERNAL_REDIRECT=you@example.com
# In production, the only domains they may go to:
# AERA_EXTERNAL_DOMAINS=

# Alerts: SMTP, Slack, Telegram or a webhook; values in .secrets/notify.env.
#   AERA_SMTP_HOST= AERA_SMTP_PORT=587 AERA_SMTP_USER= AERA_SMTP_PASSWORD= AERA_MAIL_FROM=
# Finding customers (values in .secrets/notify.env): web search, and the inbox replies come back to.
#   AERA_BRAVE_API_KEY=            or AERA_TAVILY_API_KEY=   (without either: keyless DuckDuckGo, best effort)
#   AERA_IMAP_HOST= AERA_IMAP_PORT=993 AERA_IMAP_USER= AERA_IMAP_PASSWORD= AERA_IMAP_FOLDER=INBOX
#   AERA_INBOUND_SECRET=           mail forwarded to POST /public/inbound/email
#   AERA_SLACK_WEBHOOK_URL= AERA_TELEGRAM_BOT_TOKEN= AERA_TELEGRAM_CHAT_ID= AERA_WEBHOOK_URL=
#   COMPOSIO_API_KEY= AERA_COMPOSIO_USER_ID=aera

# PORT=8787
# AERA_HOST=127.0.0.1
