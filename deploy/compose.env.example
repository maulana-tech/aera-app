# Copy to the repo root as .env (gitignored, never baked into an image). docker compose reads it.
AERA_DOMAIN=aera.example.com
# The host port the web app listens on (127.0.0.1 only). Change it when 3000 is taken.
AERA_WEB_PORT=3000
# Optional: the read-only demo account shown on /login. Create the user first:
#   docker compose exec agents python manage.py user demo@aera.example "Demo" viewer "<password>"
AERA_DEMO_EMAIL=
AERA_DEMO_PASSWORD=
