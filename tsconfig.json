{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // lib/*.test.mts imports "./gist.ts" because that is the path `node --test`
    // resolves at runtime; nothing is emitted, so tsc only has to allow it.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // sigap/deck is its own workspace: its own tsconfig, its own dependencies, and its
  // own `tsc --noEmit`. Left in, the app's include globs swallow its .tsx and then
  // fail on @open-slide/core, which only resolves after `npm install` inside deck/ -
  // so the app build broke in CI while passing on a machine that had run the deck.
  "exclude": ["node_modules", "sigap/deck"]
}
